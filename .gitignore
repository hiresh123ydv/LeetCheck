node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# --- Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS ---
.DS_Store
Thumbs.db
